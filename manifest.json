{
  "manifest_version": 3,
  "name": "WhereSub",
  "version": "0.1.0",
  "description": "Privacy-first subscription ledger. Data never leaves this device.",
  "permissions": ["storage", "alarms"],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "WhereSub"
  },
  "options_ui": {
    "page": "src/dashboard.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
